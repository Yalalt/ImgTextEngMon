# Энэ файлыг `.env` нэрээр хуулж, өөрийн түлхүүрээ бичнэ үү.
# `.env` нь .gitignore-д орсон — түлхүүр хэзээ ч commit хийгдэхгүй.
#
# Түлхүүр авах: https://platform.claude.com/settings/keys
# ЗӨВХӨН сервер тал уншина (api/ocr.js). Браузерын багцад хэзээ ч орохгүй.
ANTHROPIC_API_KEY=

# Нэмэлт: локал API серверийн порт (default 5174).
# Өөрчилвөл package.json доторх "proxy"-г мөн шинэчилнэ үү.
# API_PORT=5174

# Нэмэлт: proxy өөр домэйнд байрлаж байвал (ж: статик hosting).
# CRA build-ийн үед шингэдэг тул REACT_APP_ угтвартай байх ёстой.
# REACT_APP_OCR_API_URL=https://my-proxy.example.com/api/ocr
